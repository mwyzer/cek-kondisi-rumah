# Pilih SATU cara akses model AI:

# 1) Vercel AI Gateway (disarankan) — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# 2) Langsung ke Anthropic — dipakai bila AI_GATEWAY_API_KEY kosong
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Database. Kosong = file SQLite lokal di ./data/penilaian.db
# Produksi (mis. Turso): DATABASE_URL=libsql://nama-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Layanan analisis foto Python (folder analyzer/). Kosong = dilewati.
ANALYZER_URL=http://127.0.0.1:8000
