# Choose ONE way to access the AI model:

# 1) Vercel AI Gateway (recommended) — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# 2) Direct Anthropic access — used when AI_GATEWAY_API_KEY is empty
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Database. Empty = local SQLite file at ./data/penilaian.db
# Production (e.g. Turso): DATABASE_URL=libsql://your-database.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Python photo-analysis service (analyzer/). Empty = skipped.
ANALYZER_URL=http://127.0.0.1:8000

# 3D scanning (Gaussian Splatting). Enabled when the first three values are set.
# Vercel Blob: Vercel → Storage → Blob store
BLOB_READ_WRITE_TOKEN=
# URL of the "start" endpoint from `modal deploy` (e.g. https://<account>--cek-kondisi-rumah-splat-mulai.modal.run)
MODAL_SPLAT_URL=
# Must match SPLAT_TOKEN in the Modal secret "cek-rumah-splat".
SPLAT_TOKEN=
# Maximum scans per 24 hours to limit GPU costs.
MAKS_PEMINDAIAN_HARIAN=5
